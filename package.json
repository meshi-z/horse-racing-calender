{
  "name": "horse-racing-calendar",
  "private": true,
  "version": "1.45.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:build": "tsx scripts/parse-races.ts",
    "data:update-times": "tsx scripts/update-race-times.ts",
    "data:update-times:uk": "tsx scripts/update-race-times.ts --org bha",
    "data:update-times:us": "tsx scripts/update-race-times.ts --org equibase",
    "data:update-times:hk": "tsx scripts/update-race-times.ts --org hkjc",
    "data:update-times:ie": "tsx scripts/update-race-times.ts --org hri",
    "data:update-times:au": "tsx scripts/update-race-times.ts --org racing_australia",
    "data:update-results": "tsx scripts/update-race-results.ts",
    "data:update-results:au": "tsx scripts/update-race-results.ts --org racing_australia",
    "data:backfill-results": "tsx scripts/backfill-race-winners.ts",
    "data:backfill-nar": "tsx scripts/backfill-nar-past-times.ts",
    "data:backfill-jra": "tsx scripts/backfill-jra-past-times.ts",
    "icons:generate": "tsx scripts/generate-pwa-icons.ts",
    "docs:pdf": "node scripts/generate-prd-pdf.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  }
}
